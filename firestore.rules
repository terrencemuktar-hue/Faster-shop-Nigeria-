rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isApprovedVendor(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.role == 'vendor'
        && get(/databases/$(database)/documents/users/$(userId)).data.vendorStatus == 'approved';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || (isSignedIn() && request.auth.uid == userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['buyer', 'vendor']
        && request.resource.data.vendorStatus in ['none', 'approved', 'pending']
        && request.resource.data.displayName is string
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && request.resource.data.storeName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['buyer', 'vendor']
        && request.resource.data.vendorStatus in ['none', 'approved', 'pending']
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isApprovedVendor(request.auth.uid)
        && request.resource.data.vendorId == request.auth.uid
        && request.resource.data.vendor is string
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.inventory is number
        && request.resource.data.category is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isSignedIn()
        && isApprovedVendor(request.auth.uid)
        && resource.data.vendorId == request.auth.uid
        && request.resource.data.vendorId == request.auth.uid
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isSignedIn()
        && isApprovedVendor(request.auth.uid)
        && resource.data.vendorId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.vendorId is string
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.status in ['new', 'processing', 'packed', 'shipped', 'delivered']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        (resource.data.vendorId == request.auth.uid && isApprovedVendor(request.auth.uid))
      );

      allow update: if isSignedIn() && (
        (resource.data.buyerId == request.auth.uid && request.resource.data.buyerId == request.auth.uid) ||
        (resource.data.vendorId == request.auth.uid && isApprovedVendor(request.auth.uid))
      )
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}